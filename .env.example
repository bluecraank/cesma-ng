# Copy to .env and adjust. All CESMA_* variables are read by the backend.

# --- General ---------------------------------------------------------------
CESMA_ENVIRONMENT=production
# Long random value, e.g. `openssl rand -base64 48`. Encrypts stored switch credentials:
# changing it later makes existing secrets unreadable.
CESMA_SECRET_KEY=
POSTGRES_PASSWORD=

# --- Web server (Caddy) ----------------------------------------------------
CESMA_SITE_ADDRESS=cesma.domain.local
# "internal" = certificate from Caddy's own CA; or an e-mail address for Let's Encrypt
CESMA_TLS=internal

# --- Login (Active Directory / LDAP) ---------------------------------------
CESMA_AUTH_BACKEND=ldap
CESMA_LDAP_URL=ldaps://dc1.domain.local:636
CESMA_LDAP_BIND_DN=CN=cesma-readonly,OU=Service,DC=domain,DC=local
CESMA_LDAP_BIND_PASSWORD=
CESMA_LDAP_BASE_DN=DC=domain,DC=local
# Optional: only members of this group (nested membership counts) may log in
CESMA_LDAP_REQUIRED_GROUP=CN=CESMA_USERS,OU=Groups,DC=domain,DC=local
CESMA_LDAP_VERIFY_TLS=true
# CESMA_LDAP_CA_FILE=/etc/ssl/certs/domain-ca.pem

# --- SSO via reverse proxy (optional) ---------------------------------------
# The proxy (e.g. Authentik) puts the user name into this header. cesma-ng only accepts it
# from the listed addresses (as seen by Caddy) and still checks the user in LDAP.
# CESMA_SSO_HEADER=X-Authentik-Username
# CESMA_SSO_TRUSTED_PROXIES=["10.0.0.5/32"]

# --- Mail (weekly backup report, optional) ---------------------------------
# CESMA_SMTP_HOST=mail.domain.local
# CESMA_SMTP_PORT=587
# CESMA_SMTP_USERNAME=mailer@domain.local
# CESMA_SMTP_PASSWORD=
# CESMA_MAIL_FROM=cesma-ng@domain.local
# CESMA_BACKUP_MAIL_TO=backup@domain.local

# --- Clients ---------------------------------------------------------------
# Weekly download of the IEEE MAC vendor list (needs internet access)
CESMA_OUI_AUTO_UPDATE=true

# --- Sessions --------------------------------------------------------------
CESMA_SESSION_TTL_HOURS=12
CESMA_COOKIE_SECURE=true
