{
	# Certificates: set CESMA_SITE_ADDRESS to the DNS name(s), comma-separated, IP addresses
	# allowed (e.g. "cesma.domain.local, 10.0.0.5"). For intranet names without public DNS,
	# "tls internal" below issues a certificate from Caddy's own CA.
	admin off
	# Caddy's own redirect would always point to port 443; the block below uses the
	# published port instead (CESMA_HTTPS_PORT, see docker-compose.yml).
	auto_https disable_redirects
}

http:// {
	redir https://{host}:{$CESMA_HTTPS_PORT:443}{uri} permanent
}

{$CESMA_SITE_ADDRESS:localhost} {
	tls {$CESMA_TLS:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
